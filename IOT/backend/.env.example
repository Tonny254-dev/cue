# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True

# Arduino USB serial (PlatformIO uses COM10 on this machine)
SERIAL_PORT=COM10
SERIAL_BAUD=9600

# TextSMS Kenya — get these from https://textsms.co.ke (GET API KEY & PARTNER ID)
TEXTSMS_API_KEY=your_api_key_here
TEXTSMS_PARTNER_ID=your_partner_id_here
TEXTSMS_SHORTCODE=TEXTSMS

# Admins who receive leak SMS (comma-separated, 0... or 254... formats OK)
ALERT_PHONES=0769227291,0116019400,0701519479

# MsingiAI voice (STT + TTS) — https://platform.msingiai.com
# Keep the key server-side only. Without it, CUE still answers and uses browser speech.
MSINGI_API_KEY=
MSINGI_BASE_URL=https://api.msingiai.com
MSINGI_VOICE_ID=female3
